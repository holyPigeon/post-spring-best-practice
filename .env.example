SPRING_PROFILES_ACTIVE=local
APP_PORT=8080
SERVER_PORT=8080
MYSQL_PORT=3306
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=50.0 -XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Seoul

MYSQL_DATABASE=spring_best_practice
MYSQL_USER=spring
MYSQL_PASSWORD=spring
MYSQL_ROOT_PASSWORD=root

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/spring_best_practice?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=spring
SPRING_DATASOURCE_PASSWORD=spring
SPRING_JPA_HIBERNATE_DDL_AUTO=update

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

JWT_SECRET=spring-best-practice-jwt-secret-key-must-be-256bits-or-longer-than-that
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
